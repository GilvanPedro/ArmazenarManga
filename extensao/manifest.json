{
  "manifest_version": 3,
  "name": "Viracap - próximo capítulo",
  "version": "1.4.0",
  "description": "Abre o próximo capítulo certo nos sites de leitura que mudam o link a cada capítulo e bloqueiam servidores. Funciona junto com o site Viracap.",
  "permissions": ["tabs", "scripting", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "fundo.js",
    "scripts": ["fundo.js"]
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["conteudo.js"],
      "run_at": "document_end"
    }
  ],
  "commands": {
    "marcar-lido": {
      "suggested_key": { "default": "Alt+Shift+L" },
      "description": "Marcar o capítulo aberto como lido"
    }
  },
  "action": {
    "default_title": "Viracap",
    "default_popup": "popup.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "viracap@gilvanpedro",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["browsingActivity", "websiteContent"]
      }
    }
  }
}
